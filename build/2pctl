#!/bin/bash
#
# 2Panel Management Script
#

BASE_DIR=/opt/2panel
LANGUAGE=zh
ORIGINAL_VERSION=2.0.0
ORIGINAL_PASSWORD=**********
CHANGE_USER_INFO=

SERVICE_DIR="/etc/systemd/system"
CORE_SERVICE="2panel-core.service"
AGENT_SERVICE="2panel-agent.service"

show_usage() {
    echo "Usage: 2pctl {start|stop|restart|status|enable|disable|logs|version}"
    exit 1
}

case "${1:-}" in
    start)
        echo "Starting 2Panel services..."
        systemctl start "$CORE_SERVICE"
        systemctl start "$AGENT_SERVICE"
        echo "Done."
        ;;
    stop)
        echo "Stopping 2Panel services..."
        systemctl stop "$AGENT_SERVICE"
        systemctl stop "$CORE_SERVICE"
        echo "Done."
        ;;
    restart)
        echo "Restarting 2Panel services..."
        systemctl restart "$CORE_SERVICE"
        systemctl restart "$AGENT_SERVICE"
        echo "Done."
        ;;
    status)
        echo "=== 2Panel Service Status ==="
        systemctl status "$CORE_SERVICE" --no-pager
        echo "---"
        systemctl status "$AGENT_SERVICE" --no-pager
        ;;
    enable)
        systemctl enable "$CORE_SERVICE"
        systemctl enable "$AGENT_SERVICE"
        echo "Services enabled to start on boot."
        ;;
    disable)
        systemctl disable "$CORE_SERVICE"
        systemctl disable "$AGENT_SERVICE"
        echo "Services disabled from starting on boot."
        ;;
    logs)
        journalctl -u "$CORE_SERVICE" -u "$AGENT_SERVICE" -f
        ;;
    version)
        echo "2Panel v${ORIGINAL_VERSION}"
        ;;
    *)
        show_usage
        ;;
esac
